# XYZ Backend Configuration
PROJECT_NAME="XYZ Social AI SaaS"

# Database: Leave blank for local SQLite (zero-setup) or provide Supabase Postgres URL
# Example Supabase: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL="sqlite:///./xyz_local.db"

# JWT and Key Encryption
SECRET_KEY="replace-with-secure-32-byte-hex-string"
ENCRYPTION_KEY="replace-with-aes-256-key-for-secrets"

# Optional Server-Side AI Provider API Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Local File Storage
STORAGE_LOCAL_DIR="./storage_uploads"

# Allowed CORS Origins (comma-separated). *.vercel.app is also allowed automatically.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

